# ══════════════════════════════════════
#   UniGames — variables de entorno
# ══════════════════════════════════════
# Copiá este archivo como .env y completá los valores.
# El .env NO se sube a GitHub (está en .gitignore).

# Puerto local (Render lo pone solo)
PORT=3000

# Clave para firmar los JWT. Obligatoria: sin ella el server no arranca.
# Generá una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Conexión a PostgreSQL (Supabase / Neon). Si no está, usa localhost:5432/unigames.
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Supabase Auth (Project Settings > API). Obligatorias: sin ellas el server no arranca.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# "production" activa la caché larga de imágenes/audio. En local dejalo vacío.
NODE_ENV=
