/* ══════════════════════════════════════
   JueFriv — styles.css
   ══════════════════════════════════════ */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --blue-dark:   #0f1e3d;
  --blue-mid:    #1a3a6b;
  --blue-accent: #2563eb;
  --blue-light:  #3b82f6;
  --yellow:      #f5c518;
  --yellow-glow: #ffe066;
  --white:       #ffffff;
  --gray-light:  #f1f5f9;
  --gray-mid:    #94a3b8;
  --text-dark:   #1e293b;
  --card-shadow: 0 4px 20px rgba(37, 99, 235, 0.15);
}

body {
  font-family: 'Nunito', sans-serif;
  background: var(--white);
  color: var(--text-dark);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Fondo GIF */
body.has-bg-gif {
  background: url('../fondo.gif') center center / cover fixed;
  background-color: var(--blue-dark);
}
body.has-bg-gif main {
  background: rgba(255,255,255,0.88);
  border-radius: 0;
}

/* ─── HEADER ─── */
header {
  background: linear-gradient(135deg, var(--blue-dark) 0%, var(--blue-mid) 100%);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 1.5rem;
  height: 64px;
  gap: 1rem;
}

/* Hamburguesa */
.hamburger {
  background: none;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 8px;
  cursor: pointer;
  width: 42px;
  height: 42px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  flex-shrink: 0;
  transition: border-color 0.2s, background 0.2s;
}
.hamburger:hover {
  border-color: var(--yellow);
  background: rgba(245, 197, 24, 0.1);
}
.hamburger span {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--white);
  border-radius: 2px;
  transition: all 0.3s;
}
.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* Logo */
.logo {
  font-family: 'Press Start 2P', monospace;
  font-size: clamp(14px, 2.5vw, 22px);
  color: var(--yellow);
  text-shadow:
    0 0 8px var(--yellow-glow),
    0 0 20px rgba(245, 197, 24, 0.5),
    2px 2px 0 #7a5f00;
  letter-spacing: 2px;
  cursor: pointer;
  user-select: none;
  white-space: nowrap;
}

/* Área de autenticación */
.auth-area {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-shrink: 0;
}
.btn-auth {
  font-family: 'Nunito', sans-serif;
  font-weight: 700;
  font-size: 0.82rem;
  padding: 0.45rem 1rem;
  border-radius: 8px;
  cursor: pointer;
  border: 2px solid transparent;
  transition: all 0.2s;
  white-space: nowrap;
}
.btn-login {
  background: transparent;
  border-color: rgba(255, 255, 255, 0.5);
  color: var(--white);
}
.btn-login:hover {
  border-color: var(--yellow);
  color: var(--yellow);
}
.btn-register {
  background: var(--yellow);
  color: var(--blue-dark);
}
.btn-register:hover {
  background: var(--yellow-glow);
  transform: translateY(-1px);
}

/* ─── MENÚ DESPLEGABLE ─── */
.nav-menu {
  background: var(--blue-mid);
  border-top: 2px solid var(--blue-accent);
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.35s ease;
}
.nav-menu.open { max-height: 300px; }

.nav-menu ul {
  list-style: none;
  padding: 0.5rem 1.5rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.nav-menu ul li a {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  color: rgba(255, 255, 255, 0.85);
  text-decoration: none;
  font-weight: 700;
  font-size: 0.95rem;
  border-radius: 8px;
  transition: background 0.2s, color 0.2s, padding-left 0.2s;
}
.nav-menu ul li a:hover,
.nav-menu ul li a.active {
  background: rgba(37, 99, 235, 0.5);
  color: var(--yellow);
  padding-left: 1.4rem;
}
.nav-icon { font-size: 1.1rem; }

/* ─── MAIN ─── */
main {
  flex: 1;
  padding: 2rem 1.5rem;
  max-width: 1100px;
  margin: 0 auto;
  width: 100%;
}

/* ─── SECCIONES ─── */
.section { display: none; animation: fadeIn 0.3s ease; }
.section.active { display: block; }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─── INICIO — HERO ─── */
.hero {
  text-align: center;
  padding: 2.5rem 1rem 2rem;
}
.hero-badge {
  display: inline-block;
  background: var(--blue-accent);
  color: white;
  font-size: 0.75rem;
  font-weight: 800;
  padding: 0.3rem 1rem;
  border-radius: 20px;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 1rem;
}
.hero h1 {
  font-family: 'Press Start 2P', monospace;
  font-size: clamp(18px, 3vw, 28px);
  color: var(--blue-dark);
  line-height: 1.6;
  margin-bottom: 1rem;
}
.hero h1 span { color: var(--blue-accent); }
.hero p {
  font-size: 1.05rem;
  color: #475569;
  max-width: 600px;
  margin: 0 auto 0.5rem;
  line-height: 1.7;
}

.section-title {
  font-family: 'Press Start 2P', monospace;
  font-size: clamp(11px, 1.8vw, 15px);
  color: var(--blue-dark);
  margin-bottom: 1.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 3px solid var(--blue-accent);
  display: inline-block;
}

/* Grid de juegos destacados */
.featured-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.25rem;
  margin-top: 2rem;
}

/* Cards simples (inicio) */
.game-card {
  background: var(--white);
  border: 2px solid #e2e8f0;
  border-radius: 16px;
  padding: 1.5rem;
  box-shadow: var(--card-shadow);
  transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.game-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(37, 99, 235, 0.22);
  border-color: var(--blue-accent);
}
.card-emoji { font-size: 2.5rem; }
.card-title {
  font-family: 'Press Start 2P', monospace;
  font-size: 10px;
  color: var(--blue-dark);
  line-height: 1.6;
}
.card-desc { font-size: 0.88rem; color: #64748b; line-height: 1.5; }
.card-tag {
  display: inline-block;
  background: var(--gray-light);
  color: var(--blue-accent);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.25rem 0.65rem;
  border-radius: 20px;
  align-self: flex-start;
}

/* Botón jugar */
.btn-play {
  margin-top: auto;
  background: var(--blue-accent);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 0.6rem 1.2rem;
  font-family: 'Nunito', sans-serif;
  font-weight: 800;
  font-size: 0.9rem;
  cursor: pointer;
  transition: background 0.2s, transform 0.15s;
}
.btn-play:hover {
  background: var(--blue-dark);
  transform: scale(1.03);
}

/* ─── SECCIÓN JUEGOS ─── */
.games-intro {
  background: linear-gradient(135deg, var(--blue-dark), var(--blue-mid));
  color: white;
  border-radius: 16px;
  padding: 1.5rem 2rem;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}
.games-intro-icon { font-size: 2.5rem; }
.games-intro p { font-size: 0.95rem; line-height: 1.6; opacity: 0.9; }

.games-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.5rem;
}

/* Cards completas (sección juegos) */
.game-card-full {
  background: var(--white);
  border: 2px solid #e2e8f0;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--card-shadow);
  transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  display: flex;
  flex-direction: column;
}
.game-card-full:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(37, 99, 235, 0.22);
  border-color: var(--blue-accent);
}
.card-header-band {
  background: linear-gradient(135deg, var(--blue-dark), var(--blue-mid));
  padding: 1.25rem 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}
.card-header-band .card-emoji { font-size: 2rem; }
.card-header-band .card-title { color: var(--yellow); font-size: 9px; }

.card-body {
  padding: 1.25rem 1.5rem;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.card-body .card-desc { font-size: 0.9rem; }
.card-body .btn-play { width: 100%; }

/* Selector de temática */
.theme-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.25rem;
}
.theme-selector span {
  font-size: 0.78rem;
  font-weight: 700;
  color: #64748b;
  margin-right: 0.25rem;
  display: flex;
  align-items: center;
}
.theme-btn {
  background: var(--gray-light);
  border: 2px solid transparent;
  border-radius: 20px;
  padding: 0.3rem 0.8rem;
  font-family: 'Nunito', sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--text-dark);
  cursor: pointer;
  transition: all 0.2s;
}
.theme-btn:hover,
.theme-btn.selected {
  background: var(--blue-accent);
  color: white;
  border-color: var(--blue-accent);
}
.no-theme-note {
  font-size: 0.78rem;
  color: var(--gray-mid);
  font-style: italic;
}

/* ─── SECCIÓN PUNTUACIÓN ─── */
.scores-header {
  background: linear-gradient(135deg, var(--blue-dark), var(--blue-mid));
  color: white;
  border-radius: 16px;
  padding: 1.5rem 2rem;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}
.scores-header .icon { font-size: 2.5rem; }
.scores-header p { font-size: 0.95rem; line-height: 1.6; opacity: 0.9; }

.scores-table-wrap {
  background: white;
  border: 2px solid #e2e8f0;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--card-shadow);
}
table { width: 100%; border-collapse: collapse; }

thead {
  background: linear-gradient(135deg, var(--blue-dark), var(--blue-mid));
  color: white;
}
thead th {
  padding: 1rem 1.25rem;
  text-align: left;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

tbody tr { border-bottom: 1px solid #f1f5f9; transition: background 0.15s; }
tbody tr:last-child { border-bottom: none; }
tbody tr:hover { background: #f8fafc; }
tbody td { padding: 0.9rem 1.25rem; font-size: 0.9rem; }

.rank-1 { font-weight: 800; color: #b7791f; }
.rank-2 { font-weight: 800; color: #718096; }
.rank-3 { font-weight: 800; color: #c05621; }

.score-badge {
  background: var(--blue-accent);
  color: white;
  border-radius: 20px;
  padding: 0.2rem 0.7rem;
  font-weight: 800;
  font-size: 0.82rem;
}
.game-pill {
  background: var(--gray-light);
  color: var(--blue-dark);
  border-radius: 20px;
  padding: 0.2rem 0.65rem;
  font-size: 0.78rem;
  font-weight: 700;
}

/* ─── MODAL ─── */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(15, 30, 61, 0.7);
  backdrop-filter: blur(4px);
  z-index: 200;
  align-items: center;
  justify-content: center;
}
.modal-overlay.open { display: flex; }

.modal {
  background: white;
  border-radius: 20px;
  padding: 2rem;
  width: min(420px, 92vw);
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.3);
  animation: popIn 0.25s ease;
}
@keyframes popIn {
  from { opacity: 0; transform: scale(0.9); }
  to   { opacity: 1; transform: scale(1); }
}
.modal-title {
  font-family: 'Press Start 2P', monospace;
  font-size: 12px;
  color: var(--blue-dark);
  margin-bottom: 1.5rem;
  line-height: 1.6;
}
.modal-close {
  float: right;
  background: none;
  border: none;
  font-size: 1.4rem;
  cursor: pointer;
  color: #94a3b8;
  margin-top: -0.5rem;
  transition: color 0.2s;
}
.modal-close:hover { color: var(--blue-dark); }

.modal-tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
  background: var(--gray-light);
  padding: 0.3rem;
  border-radius: 10px;
}
.tab-btn {
  flex: 1;
  padding: 0.55rem;
  border: none;
  border-radius: 8px;
  font-family: 'Nunito', sans-serif;
  font-weight: 800;
  font-size: 0.9rem;
  cursor: pointer;
  background: transparent;
  color: #64748b;
  transition: all 0.2s;
}
.tab-btn.active {
  background: var(--blue-accent);
  color: white;
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
}

.form-group { margin-bottom: 1rem; }
.form-group label {
  display: block;
  font-weight: 700;
  font-size: 0.85rem;
  margin-bottom: 0.4rem;
  color: var(--text-dark);
}
.form-group input {
  width: 100%;
  padding: 0.65rem 1rem;
  border: 2px solid #e2e8f0;
  border-radius: 10px;
  font-family: 'Nunito', sans-serif;
  font-size: 0.95rem;
  transition: border-color 0.2s;
  outline: none;
}
.form-group input:focus { border-color: var(--blue-accent); }

.btn-modal-submit {
  width: 100%;
  background: var(--blue-accent);
  color: white;
  border: none;
  border-radius: 10px;
  padding: 0.75rem;
  font-family: 'Nunito', sans-serif;
  font-weight: 800;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.2s;
  margin-top: 0.5rem;
}
.btn-modal-submit:hover { background: var(--blue-dark); }

/* ─── FOOTER ─── */
footer {
  background: linear-gradient(135deg, var(--blue-dark) 0%, var(--blue-mid) 100%);
  color: rgba(255, 255, 255, 0.65);
  text-align: center;
  padding: 1.25rem;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  margin-top: auto;
}
footer span { color: var(--yellow); }

/* ─── PANTALLAS DE JUEGO ─── */
.game-screen-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}
.btn-back {
  background: var(--gray-light);
  border: 2px solid #e2e8f0;
  border-radius: 8px;
  padding: 0.45rem 1rem;
  font-family: 'Nunito', sans-serif;
  font-weight: 700;
  font-size: 0.85rem;
  cursor: pointer;
  color: var(--blue-dark);
  transition: all 0.2s;
  flex-shrink: 0;
}
.btn-back:hover { background: #e2e8f0; }

.game-screen-title {
  font-family: 'Press Start 2P', monospace;
  font-size: clamp(10px, 2vw, 14px);
  color: var(--blue-dark);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.game-screen-theme {
  background: var(--blue-accent);
  color: white;
  border-radius: 20px;
  padding: 0.25rem 0.9rem;
  font-size: 0.8rem;
  font-weight: 800;
  margin-left: auto;
}

/* Coming soon */
.coming-soon-box {
  background: white;
  border: 2px dashed #e2e8f0;
  border-radius: 20px;
  padding: 3rem 2rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  max-width: 480px;
  margin: 0 auto;
}
.cs-emoji { font-size: 4rem; }
.cs-title {
  font-family: 'Press Start 2P', monospace;
  font-size: 12px;
  color: var(--blue-dark);
}
.cs-desc { font-size: 0.92rem; color: #64748b; line-height: 1.6; }

/* ─── AHORCADO ─── */
.ahorcado-wrap {
  display: flex;
  gap: 2.5rem;
  align-items: flex-start;
  flex-wrap: wrap;
  justify-content: center;
}
.ahorcado-drawing {
  background: var(--gray-light);
  border-radius: 16px;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160px;
}
.hang-part { display: none; }

.ahorcado-main {
  flex: 1;
  min-width: 260px;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.ahorcado-word {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: center;
  padding: 1rem 0;
}
.letter-box {
  width: 36px;
  height: 44px;
  border-bottom: 3px solid var(--blue-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Press Start 2P', monospace;
  font-size: 14px;
  color: var(--blue-dark);
  transition: color 0.2s;
}
.letter-box.miss { color: #e53e3e; }

.ahorcado-status {
  text-align: center;
  font-weight: 800;
  font-size: 1rem;
  min-height: 1.5rem;
  color: var(--blue-dark);
}
.ahorcado-status.win  { color: #38a169; }
.ahorcado-status.lose { color: #e53e3e; }

.ahorcado-keyboard {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  justify-content: center;
}
.key-btn {
  width: 38px;
  height: 38px;
  border: 2px solid #e2e8f0;
  border-radius: 8px;
  background: white;
  font-family: 'Nunito', sans-serif;
  font-weight: 800;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.15s;
  color: var(--text-dark);
}
.key-btn:hover:not(:disabled) {
  background: var(--blue-accent);
  color: white;
  border-color: var(--blue-accent);
}
.key-btn:disabled { opacity: 0.3; cursor: not-allowed; }
.key-btn.hit  { background: #38a169; color: white; border-color: #38a169; }
.key-btn.miss { background: #e53e3e; color: white; border-color: #e53e3e; }

.ahorcado-actions { display: flex; gap: 1rem; }

/* ─── ADIVINA LA PALABRA (estilo Wordle) ─── */
.wordle-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  max-width: 560px;
  margin: 0 auto;
}
.wordle-hint {
  text-align: center;
  font-size: 0.92rem;
  font-weight: 700;
  color: var(--blue-dark);
}
.wordle-board {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.wordle-row {
  display: flex;
  gap: 0.4rem;
  justify-content: center;
}
.wordle-tile {
  width: 42px;
  height: 42px;
  border: 2px solid #e2e8f0;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Press Start 2P', monospace;
  font-size: 14px;
  color: var(--blue-dark);
  background: white;
  transition: all 0.2s;
  text-transform: uppercase;
}
.wordle-tile.filled { border-color: var(--blue-accent); }
.wordle-tile.correct { background: #38a169; border-color: #38a169; color: white; }
.wordle-tile.present { background: #d69e2e; border-color: #d69e2e; color: white; }
.wordle-tile.absent  { background: #718096; border-color: #718096; color: white; }

.wordle-status {
  text-align: center;
  font-weight: 800;
  font-size: 0.95rem;
  min-height: 1.4rem;
  color: var(--blue-dark);
}
.wordle-status.win  { color: #38a169; }
.wordle-status.lose { color: #e53e3e; }
.wordle-status.warn { color: #d69e2e; }

.wordle-keyboard {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  justify-content: center;
  max-width: 480px;
}
.wordle-keyboard .key-btn.correct { background: #38a169; color: white; border-color: #38a169; }
.wordle-keyboard .key-btn.present { background: #d69e2e; color: white; border-color: #d69e2e; }
.wordle-keyboard .key-btn.absent  { background: #718096; color: white; border-color: #718096; opacity: 0.7; }

.wordle-controls { display: flex; gap: 0.75rem; }
.key-btn-wide {
  border: 2px solid #e2e8f0;
  border-radius: 8px;
  background: white;
  font-family: 'Nunito', sans-serif;
  font-weight: 800;
  font-size: 0.85rem;
  padding: 0.55rem 1.2rem;
  cursor: pointer;
  color: var(--text-dark);
  transition: all 0.15s;
}
.key-btn-wide:hover { background: var(--gray-light); }
.key-btn-enter { background: var(--blue-accent); color: white; border-color: var(--blue-accent); }
.key-btn-enter:hover { background: var(--blue-dark); }

/* ─── PIXEL RUNNER ─── */
.runner-score-display {
  margin-left: auto;
  font-family: 'Press Start 2P', monospace;
  font-size: 11px;
  color: var(--blue-dark);
  background: var(--yellow);
  padding: 0.4rem 0.9rem;
  border-radius: 20px;
}

.runner-container {
  position: relative;
  width: 100%;
  max-width: 800px;
  margin: 0 auto;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 32px rgba(15,30,61,0.25);
  border: 3px solid #1a3a6b;
  background: #0d1b2a;
}

#runnerCanvas {
  display: block;
  width: 100%;
  image-rendering: pixelated;
}

.runner-overlay {
  position: absolute;
  inset: 0;
  background: rgba(10, 20, 40, 0.82);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(2px);
}
.runner-overlay.hidden { display: none; }

.runner-overlay-box {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  padding: 2rem;
}

.runner-char-preview { margin-bottom: 0.5rem; }

.runner-overlay-title {
  font-family: 'Press Start 2P', monospace;
  font-size: clamp(12px, 2vw, 18px);
  color: var(--yellow);
  text-shadow: 0 0 12px rgba(245,197,24,0.5);
}
.runner-overlay-sub {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.8);
  line-height: 1.7;
}
.runner-best {
  font-family: 'Press Start 2P', monospace;
  font-size: 9px;
  color: #93c5fd;
  min-height: 1rem;
}
.runner-start-btn {
  background: var(--yellow);
  color: var(--blue-dark);
  font-weight: 900;
  font-size: 1rem;
  padding: 0.7rem 2rem;
  border-radius: 10px;
  margin-top: 0.5rem;
}

.runner-hint {
  text-align: center;
  margin-top: 0.75rem;
  font-size: 0.78rem;
  color: #64748b;
  font-weight: 600;
}

.runner-controls {
  display: flex;
  gap: 1rem;
  justify-content: center;
  margin-top: 0.9rem;
}
.runner-ctrl-btn {
  background: var(--blue-dark);
  color: white;
  border: 2px solid var(--blue-accent);
  border-radius: 10px;
  padding: 0.6rem 1.8rem;
  font-family: 'Nunito', sans-serif;
  font-weight: 800;
  font-size: 1rem;
  cursor: pointer;
  user-select: none;
  touch-action: manipulation;
  transition: background 0.15s, transform 0.1s;
}
.runner-ctrl-btn:active {
  background: var(--blue-accent);
  transform: scale(0.96);
}

/* ─── RESPONSIVE ─── */
@media (max-width: 480px) {
  .btn-register { display: none; }
  .hero h1 { font-size: 14px; }
  .featured-grid { grid-template-columns: 1fr; }
}
